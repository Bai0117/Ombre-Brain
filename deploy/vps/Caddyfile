# Caddy 反代：自动 HTTPS（Let's Encrypt），把所有请求转给 OB。
# OMBRE_SITE_ADDRESS 由 install.sh 写进 .env：
#   有域名 → 你的域名；没有域名 → <公网IP用短横线>.sslip.io（免费，自动解析到这台机器）

{$OMBRE_SITE_ADDRESS} {
	reverse_proxy ombre-brain:8000 {
		# MCP 是流式响应，立刻转发，不要缓冲
		flush_interval -1
		# Caddy 默认会保留原始 Host，并附带 X-Forwarded-For / -Proto / -Host
	}
}

# 同一台机器上的其他服务（例如聊天应用）在宿主 /opt/ombre-sites/ 里放一个 *.caddy，
# 就能共用这个 Caddy 和自动 HTTPS。目录为空时这一行什么也不做。
# 新加了站点文件后：docker exec ombre-caddy caddy reload --config /etc/caddy/Caddyfile
import /etc/caddy/sites/*.caddy
